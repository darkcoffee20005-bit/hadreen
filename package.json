{
  "name": "hadreen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "tsx scripts/shots.ts",
    "fonts": "tsx scripts/fetch-fonts.ts",
    "db:up": "bash scripts/db-local.sh up",
    "db:down": "bash scripts/db-local.sh down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "static": "tsx scripts/build-static.ts",
    "budget": "tsx scripts/budget.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "detect-gpu": "5.0.70",
    "gsap": "3.15.0",
    "harfbuzzjs": "1.6.3",
    "iron-session": "9.0.1",
    "lenis": "1.3.27",
    "leva": "0.10.1",
    "nanoid": "6.0.2",
    "next": "15.5.28",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "postprocessing": "6.39.5",
    "qrcode": "1.5.4",
    "r3f-perf": "7.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
