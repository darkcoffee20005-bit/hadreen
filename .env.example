# Copy to .env and fill in. Never commit .env.

# Postgres. Production: Neon pooled connection string (sslmode=require).
# Local: `pnpm db:up` starts a throwaway Postgres on port 54329 with these databases.
DATABASE_URL="postgresql://hadreen:hadreen@localhost:54329/hadreen"
TEST_DATABASE_URL="postgresql://hadreen:hadreen@localhost:54329/hadreen_test"
E2E_DATABASE_URL="postgresql://hadreen:hadreen@localhost:54329/hadreen_e2e"

# Public origin used in guest links, share messages, OG images and the sitemap.
SITE_URL="http://localhost:3000"

# Admin panel (/admin). Use a long password; SESSION_SECRET must be at least 32 characters.
ADMIN_PASSWORD=""
SESSION_SECRET=""

# Rate limiting. Leave empty to use the in-memory limiter (dev only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# /lab/[template] tuning pages. Never enable in production.
LAB_ENABLED="false"
